# Copy to .env.local and fill in. Never commit .env.local.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio -> https://aistudio.google.com/app/apikey (free tier)
GEMINI_API_KEY=your-gemini-key
# Optional: comma-separated model fallback order
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash

# Optional. If empty, the browser's built-in speech synthesis is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
